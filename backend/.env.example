# Local development template. Copy to `.env` and fill in real values.
# Never commit `.env` — only this example file is tracked (Constitution §2.5).

APP_ENV=development

# 256-bit random value, hex-encoded (openssl rand -hex 32).
SECRET_KEY=replace-with-256-bit-random-hex

# Least-privilege application user created by db/setup.sh.
# WSL shares ports with Windows (mirrored networking) and Windows MySQL80 owns
# 3306, so the WSL MySQL instance listens on 3307.
DATABASE_URL=mysql+asyncmy://rbac_app:replace-with-db-password@127.0.0.1:3307/rbac_learning
TEST_DATABASE_URL=mysql+asyncmy://rbac_app:replace-with-db-password@127.0.0.1:3307/rbac_learning_test

# Exact CORS allowlist; no wildcard (Constitution §2.5).
FRONTEND_ORIGIN=http://localhost:5173

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# Optional override for the demo accounts created by `python -m app.db.seed`.
# Seeding refuses to run when APP_ENV=production.
SEED_DEV_PASSWORD=DevPassw0rd!
